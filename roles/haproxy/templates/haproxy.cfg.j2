global
    log /dev/log local0
    log-tag HAProxy
    maxconn 32000
    ulimit-n 65535
    uid 0
    gid 0
    daemon

defaults
    log global
    mode tcp
    timeout connect 5s
    timeout client  1m
    timeout server  1m
    option redispatch
    retries 3
    option log-health-checks
    option dontlognull
    option dontlog-normal

# Public listeners: WAN traffic reaches this virtual IP through the router's
# port forwards. They may only reach the public Traefik release.
frontend public_http
    bind {{ prepare_detect_haproxy_virtual_ip }}:80
    mode tcp
    default_backend public-http-servers

frontend public_https
    bind {{ prepare_detect_haproxy_virtual_ip }}:443
    mode tcp
    default_backend public-https-servers
    timeout client  24h
    timeout server  24h

frontend public_mx
    bind {{ prepare_detect_haproxy_virtual_ip }}:2465
    mode tcp
    default_backend public-mx-servers

frontend public_smtp
    bind {{ prepare_detect_haproxy_virtual_ip }}:465
    mode tcp
    default_backend public-smtp-servers

frontend public_imap
    bind {{ prepare_detect_haproxy_virtual_ip }}:993
    mode tcp
    default_backend public-imap-servers
    timeout client 30m

frontend public_mqtt
    bind {{ prepare_detect_haproxy_virtual_ip }}:1883
    mode tcp
    default_backend public-mqtt-servers

frontend public_mqtts
    bind {{ prepare_detect_haproxy_virtual_ip }}:8883
    mode tcp
    default_backend public-mqtts-servers

# Private listeners: LAN and Tailscale clients use this virtual IP. It is
# never forwarded from the WAN and may reach the private Traefik release,
# which also serves public applications.
frontend private_http
    bind {{ prepare_detect_haproxy_private_ip }}:80
    mode tcp
    default_backend private-http-servers

frontend private_https
    bind {{ prepare_detect_haproxy_private_ip }}:443
    mode tcp
    default_backend private-https-servers
    timeout client  24h
    timeout server  24h

backend public-http-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option httpchk
    http-check connect port 9001
    http-check send meth GET uri /ping
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:8080 send-proxy-v2 check
{% endfor %}

backend public-https-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option httpchk
    http-check connect port 9001
    http-check send meth GET uri /ping
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:8443 send-proxy-v2 check
{% endfor %}

backend public-smtp-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option tcp-check
    tcp-check connect port 465
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:465 send-proxy-v2 check
{% endfor %}

backend public-imap-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option tcp-check
    tcp-check connect port 993
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:993 send-proxy-v2 check
{% endfor %}
    timeout server 30m

backend public-mx-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option tcp-check
    tcp-check connect port 2465
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:2465 send-proxy-v2 check
{% endfor %}

backend public-mqtt-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option tcp-check
    tcp-check connect port 1883
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:1883 send-proxy-v2 check
{% endfor %}

backend public-mqtts-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_virtual_ip }}
    option tcp-check
    tcp-check connect port 8883
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:8883 send-proxy-v2 check
{% endfor %}

backend private-http-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_private_ip }}
    option httpchk
    http-check connect port 9000
    http-check send meth GET uri /ping
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:80 send-proxy-v2 check
{% endfor %}

backend private-https-servers
    mode tcp
    balance roundrobin
    source {{ prepare_detect_haproxy_private_ip }}
    option httpchk
    http-check connect port 9000
    http-check send meth GET uri /ping
    default-server inter 3s fall 3 rise 2
{% for name, ip in haproxy.servers.items() %}
    server {{ name }} {{ ip }}:443 send-proxy-v2 check
{% endfor %}

frontend prometheus
  bind :8405
  mode http
  http-request use-service prometheus-exporter if { path /metrics }
  acl network_allowed src 10.0.0.0/8 192.168.0.0/16
  http-request deny unless network_allowed
  no log
